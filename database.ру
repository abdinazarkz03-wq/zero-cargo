import asyncpg
from datetime import datetime
import logging
import random
import string
from config import DATABASE_URL

logging.basicConfig(level=logging.INFO)
logger = logging.getLogger(__name__)

class Database:
    def __init__(self):
        self.pool = None

    async def connect(self):
        """Подключение к базе данных"""
        try:
            self.pool = await asyncpg.create_pool(DATABASE_URL, min_size=1, max_size=10, timeout=60)
            await self.create_tables()
            logger.info("✅ ZERO CARGO подключен к БД")
        except Exception as e:
            logger.error(f"❌ Ошибка подключения к БД: {e}")
            raise

    async def close(self):
        """Закрыть пул соединений"""
        if self.pool:
            await self.pool.close()
            logger.info("✅ Пул соединений закрыт")

    async def create_tables(self):
        """Создание таблиц"""
        async with self.pool.acquire() as conn:
            # Пользователи
            await conn.execute('''
                CREATE TABLE IF NOT EXISTS users (
                    user_id BIGINT PRIMARY KEY,
                    full_name VARCHAR(255) NOT NULL,
                    phone VARCHAR(20) NOT NULL,
                    address TEXT,
                    personal_code VARCHAR(50) UNIQUE,
                    china_code VARCHAR(50) UNIQUE,
                    language VARCHAR(10) DEFAULT 'ru',
                    registration_date TIMESTAMP DEFAULT NOW()
                )
            ''')

            # Посылки
            await conn.execute('''
                CREATE TABLE IF NOT EXISTS parcels (
                    id SERIAL PRIMARY KEY,
                    user_id BIGINT REFERENCES users(user_id) ON DELETE CASCADE,
                    track_code VARCHAR(100) NOT NULL,
                    description TEXT,
                    status VARCHAR(50) DEFAULT 'В ожидании',
                    created_at TIMESTAMP DEFAULT NOW(),
                    updated_at TIMESTAMP DEFAULT NOW(),
                    UNIQUE(track_code, user_id)
                )
            ''')

            # Индексы
            await conn.execute('CREATE INDEX IF NOT EXISTS idx_parcels_user_id ON parcels(user_id)')
            await conn.execute('CREATE INDEX IF NOT EXISTS idx_parcels_track_code ON parcels(track_code)')

            logger.info("✅ Таблицы созданы")

    async def generate_china_code(self):
        """Генерация уникального кода для Китая в формате VXMMM"""
        async with self.pool.acquire() as conn:
            while True:
                code = ''.join(random.choices(string.ascii_uppercase, k=5))
                exists = await conn.fetchval('SELECT 1 FROM users WHERE china_code = $1', code)
                if not exists:
                    return code

    async def register_user(self, user_id, full_name, phone, address):
        """Регистрация нового пользователя"""
        try:
            personal_code = f"ZERO-{random.randint(1000, 9999)}"
            china_code = await self.generate_china_code()

            async with self.pool.acquire() as conn:
                await conn.execute('''
                    INSERT INTO users (user_id, full_name, phone, address, personal_code, china_code)
                    VALUES ($1, $2, $3, $4, $5, $6)
                    ON CONFLICT (user_id) DO UPDATE
                    SET full_name = $2, phone = $3, address = $4
                ''', user_id, full_name, phone, address, personal_code, china_code)

                user = await conn.fetchrow(
                    'SELECT * FROM users WHERE user_id = $1', user_id
                )
                logger.info(f"✅ Пользователь зарегистрирован: {full_name} | Код для Китая: {china_code}")
                return dict(user)
        except Exception as e:
            logger.error(f"❌ Ошибка регистрации: {e}")
            return {"error": "Не удалось зарегистрировать пользователя"}

    async def get_user(self, user_id):
        async with self.pool.acquire() as conn:
            user = await conn.fetchrow('SELECT * FROM users WHERE user_id = $1', user_id)
            return dict(user) if user else None

    async def get_user_with_parcels(self, user_id):
        async with self.pool.acquire() as conn:
            user = await conn.fetchrow('SELECT * FROM users WHERE user_id = $1', user_id)
            if not user:
                return None
            user_dict = dict(user)
            parcels = await conn.fetch('''
                SELECT id, track_code, description, status, created_at, updated_at
                FROM parcels
                WHERE user_id = $1
                ORDER BY updated_at DESC
            ''', user_id)
            user_dict['parcels'] = [dict(p) for p in parcels]
            return user_dict

    async def add_parcel(self, user_id, track_code, description=None):
        """Добавление посылки"""
        async with self.pool.acquire() as conn:
            exists = await conn.fetchval('SELECT id FROM parcels WHERE user_id=$1 AND track_code=$2', user_id, track_code)
            if exists:
                return {"success": False, "message": "Посылка уже существует"}
            await conn.execute('''
                INSERT INTO parcels (user_id, track_code, description, status)
                VALUES ($1, $2, $3, 'В ожидании')
            ''', user_id, track_code, description)
            logger.info(f"✅ Добавлена посылка: {track_code}")
            return {"success": True, "message": "Посылка добавлена"}

    async def get_user_parcels(self, user_id):
        async with self.pool.acquire() as conn:
            parcels = await conn.fetch('''
                SELECT * FROM parcels WHERE user_id=$1 ORDER BY updated_at DESC
            ''', user_id)
            return [dict(p) for p in parcels]

    async def get_all_users(self):
        async with self.pool.acquire() as conn:
            users = await conn.fetch('''
                SELECT u.*, COUNT(p.id) AS parcels_count
                FROM users u
                LEFT JOIN parcels p ON p.user_id = u.user_id
                GROUP BY u.user_id
                ORDER BY u.registration_date DESC
            ''')
            return [dict(u) for u in users]

    async def get_stats(self):
        async with self.pool.acquire() as conn:
            total_users = await conn.fetchval('SELECT COUNT(*) FROM users')
            total_parcels = await conn.fetchval('SELECT COUNT(*) FROM parcels')
            today_users = await conn.fetchval('SELECT COUNT(*) FROM users WHERE DATE(registration_date)=CURRENT_DATE')
            status_stats = await conn.fetch('SELECT status, COUNT(*) AS count FROM parcels GROUP BY status')
            return {
                'total_users': total_users,
                'total_parcels': total_parcels,
                'today_users': today_users or 0,
                'status_stats': {s['status']: s['count'] for s in status_stats}
            }

    async def search_users(self, query):
        async with self.pool.acquire() as conn:
            users = await conn.fetch('''
                SELECT * FROM users 
                WHERE full_name ILIKE $1
                   OR phone ILIKE $1
                   OR personal_code ILIKE $1
                   OR china_code ILIKE $1
                ORDER BY registration_date DESC
            ''', f'%{query}%')
            return [dict(u) for u in users]

    async def set_language(self, user_id, language):
        async with self.pool.acquire() as conn:
            await conn.execute('UPDATE users SET language=$1 WHERE user_id=$2', language, user_id)

# Создаём объект базы
db = Database()
