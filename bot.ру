import logging
import json
import asyncio

from telegram import Update, InlineKeyboardButton, InlineKeyboardMarkup
from telegram.ext import (
    Application, CommandHandler, CallbackQueryHandler,
    MessageHandler, filters, ContextTypes, ConversationHandler
)

from config import *
from database import db


logging.basicConfig(
    format="%(asctime)s - %(name)s - %(levelname)s - %(message)s",
    level=logging.INFO
)

logger = logging.getLogger(__name__)


# =========================
# СОСТОЯНИЯ
# =========================

FULL_NAME, PHONE, ADDRESS, TRACK_CODE = range(4)


# =========================
# МЕНЮ
# =========================

async def get_main_menu():
    keyboard = [
        [InlineKeyboardButton("👤 Профиль", callback_data="profile")],
        [InlineKeyboardButton("📍 Адреса", callback_data="addresses")],
        [InlineKeyboardButton("📦 Мои посылки", callback_data="my_parcels")],
        [InlineKeyboardButton("📋 Инструкция", callback_data="instructions")],
        [InlineKeyboardButton("⛔ Запрещенные товары", callback_data="prohibited")],
        [InlineKeyboardButton("💬 Поддержка", callback_data="support")],
        [InlineKeyboardButton("➕ Добавить трек", callback_data="add_track")]
    ]

    return InlineKeyboardMarkup(keyboard)


async def get_language_menu():
    keyboard = [
        [InlineKeyboardButton("🇷🇺 Русский", callback_data="lang_ru")],
        [InlineKeyboardButton("🇰🇬 Кыргызча", callback_data="lang_kg")]
    ]

    return InlineKeyboardMarkup(keyboard)


# =========================
# СТАРТ
# =========================

async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):

    user_id = update.effective_user.id
    user = await db.get_user(user_id)

    if user:
        await show_main_menu(update, user)
        return

    text = (
        f"🌟 **ZERO CARGO**\n\n"
        f"Доставка из Китая в Бишкек\n"
        f"💰 {PRICE_PER_KG} за кг\n"
        f"⏱ {DELIVERY_TIME}\n"
        f"📍 {PICKUP_ADDRESS}\n\n"
        f"Пройдите регистрацию для получения персонального кода"
    )

    keyboard = [
        [InlineKeyboardButton("📝 Пройти регистрацию", callback_data="register")],
        [InlineKeyboardButton("🇷🇺 / 🇰🇬 тилин тандоо", callback_data="language")]
    ]

    await update.message.reply_text(
        text,
        parse_mode="Markdown",
        reply_markup=InlineKeyboardMarkup(keyboard)
    )


# =========================
# ГЛАВНОЕ МЕНЮ
# =========================

async def show_main_menu(update: Update, user):

    text = (
        f"👤 **Ваш профиль**\n\n"
        f"Персональный КОД: `{user['personal_code']}`\n"
        f"Код для Китая: `{user['china_code']}`\n"
        f"ФИО: {user['full_name']}\n"
        f"Номер: +{user['phone']}\n"
        f"Адрес: {user['address'] or 'Не указан'}\n\n"
        f"📍 ПВЗ: {PICKUP_ADDRESS}\n"
        f"📞 {PICKUP_PHONE}"
    )

    keyboard = [
        [InlineKeyboardButton("🚪 Войти в личный кабинет", callback_data="dashboard")]
    ]

    if update.message:
        await update.message.reply_text(
            text,
            parse_mode="Markdown",
            reply_markup=InlineKeyboardMarkup(keyboard)
        )

    else:
        await update.callback_query.edit_message_text(
            text,
            parse_mode="Markdown",
            reply_markup=InlineKeyboardMarkup(keyboard)
        )


# =========================
# РЕГИСТРАЦИЯ
# =========================

async def register_start(update: Update, context: ContextTypes.DEFAULT_TYPE):

    await update.callback_query.answer()

    await update.callback_query.edit_message_text(
        "📝 **Регистрация ZERO CARGO**\n\nВведите ФИО:",
        parse_mode="Markdown"
    )

    return FULL_NAME


async def get_full_name(update: Update, context: ContextTypes.DEFAULT_TYPE):

    context.user_data["full_name"] = update.message.text

    await update.message.reply_text(
        "📞 Введите номер телефона\n\nПример: 996704560821"
    )

    return PHONE


async def get_phone(update: Update, context: ContextTypes.DEFAULT_TYPE):

    phone = update.message.text.replace("+", "").replace(" ", "")

    if not phone.isdigit():

        await update.message.reply_text(
            "❌ Номер должен содержать только цифры"
        )

        return PHONE

    context.user_data["phone"] = phone

    await update.message.reply_text(
        "🏠 Введите адрес проживания"
    )

    return ADDRESS


async def get_address(update: Update, context: ContextTypes.DEFAULT_TYPE):

    user_id = update.effective_user.id

    user = await db.register_user(
        user_id,
        context.user_data["full_name"],
        context.user_data["phone"],
        update.message.text
    )

    await show_main_menu(update, user)

    return ConversationHandler.END


# =========================
# АДРЕС КИТАЯ
# =========================

def get_china_address(code):

    return (
        f"收件人：{code}\n"
        f"电话 ：{CHINA_PHONE_NUMBER}\n"
        f"{CHINA_ADDRESS}\n"
        f"（TSL КАРГО）{code}(Ваш код клиента)"
    )


# =========================
# КНОПКИ
# =========================

async def handle_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):

    query = update.callback_query
    await query.answer()

    user_id = query.from_user.id
    user = await db.get_user(user_id)

    if query.data == "dashboard":

        await query.edit_message_text(
            "📱 **Личный кабинет ZERO CARGO**",
            parse_mode="Markdown",
            reply_markup=await get_main_menu()
        )


    elif query.data == "profile":

        text = (
            f"👤 **Ваш профиль**\n\n"
            f"Код: `{user['personal_code']}`\n"
            f"ФИО: {user['full_name']}\n"
            f"Телефон: +{user['phone']}"
        )

        await query.edit_message_text(
            text,
            parse_mode="Markdown",
            reply_markup=InlineKeyboardMarkup(
                [[InlineKeyboardButton("◀️ Назад", callback_data="dashboard")]]
            )
        )


    elif query.data == "addresses":

        address = get_china_address(user["china_code"])

        await query.edit_message_text(
            f"🇨🇳 **Адрес склада**\n\n```\n{address}\n```",
            parse_mode="Markdown",
            reply_markup=InlineKeyboardMarkup(
                [[InlineKeyboardButton("◀️ Назад", callback_data="dashboard")]]
            )
        )


    elif query.data == "my_parcels":

        parcels = await db.get_user_parcels(user_id)

        if not parcels:
            text = "📭 Посылок пока нет"

        else:

            text = "📦 **Мои посылки**\n\n"

            for p in parcels:

                text += f"• `{p['track_code']}` — {p['status']}\n"

        await query.edit_message_text(
            text,
            parse_mode="Markdown",
            reply_markup=InlineKeyboardMarkup(
                [
                    [InlineKeyboardButton("➕ Добавить трек", callback_data="add_track")],
                    [InlineKeyboardButton("◀️ Назад", callback_data="dashboard")]
                ]
            )
        )


    elif query.data == "add_track":

        await query.edit_message_text(
            "📦 Отправьте трек код\n\n"
            "Можно несколько через запятую\n"
            "Пример:\n"
            "`YT12345, 99887766 куртка`",
            parse_mode="Markdown"
        )

        return TRACK_CODE


# =========================
# ДОБАВЛЕНИЕ ТРЕКА
# =========================

async def handle_track(update: Update, context: ContextTypes.DEFAULT_TYPE):

    tracks = [t.strip() for t in update.message.text.split(",")]

    added = 0

    for track in tracks:

        if await db.add_parcel(update.effective_user.id, track):
            added += 1

    await update.message.reply_text(
        f"✅ Добавлено посылок: {added}",
        reply_markup=await get_main_menu()
    )

    return ConversationHandler.END


# =========================
# WEBAPP
# =========================

async def webapp_data(update: Update, context: ContextTypes.DEFAULT_TYPE):

    try:

        data = json.loads(update.effective_message.web_app_data.data)

        user_id = update.effective_user.id

        if data["action"] == "getUserData":

            user = await db.get_user_with_parcels(user_id)

            await update.effective_message.reply_text(
                json.dumps({
                    "type": "userData",
                    "data": user
                }, default=str)
            )

    except Exception as e:

        logger.error(f"WebApp error {e}")


# =========================
# ЗАПУСК
# =========================

async def main():

    await db.connect()

    app = Application.builder().token(BOT_TOKEN).build()

    reg_conv = ConversationHandler(
        entry_points=[CallbackQueryHandler(register_start, pattern="register")],
        states={
            FULL_NAME: [MessageHandler(filters.TEXT, get_full_name)],
            PHONE: [MessageHandler(filters.TEXT, get_phone)],
            ADDRESS: [MessageHandler(filters.TEXT, get_address)],
        },
        fallbacks=[]
    )

    track_conv = ConversationHandler(
        entry_points=[CallbackQueryHandler(handle_callback, pattern="add_track")],
        states={
            TRACK_CODE: [MessageHandler(filters.TEXT, handle_track)]
        },
        fallbacks=[]
    )

    app.add_handler(CommandHandler("start", start))

    app.add_handler(reg_conv)
    app.add_handler(track_conv)

    app.add_handler(CallbackQueryHandler(handle_callback))

    app.add_handler(
        MessageHandler(
            filters.StatusUpdate.WEB_APP_DATA,
            webapp_data
        )
    )

    logger.info("🚀 ZERO CARGO бот запущен")

    await app.run_polling()


if __name__ == "__main__":
    asyncio.run(main())
