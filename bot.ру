    if query.from_user.id not in ADMIN_IDS:
        return
    
    if query.data == "admin_users":
        users = await db.get_all_users()
        text = "👥 **Все клиенты ZERO CARGO**\n\n"
        
        for u in users[:10]:
            text += (
                f"• {u['full_name']}\n"
                f"  📱 +{u['phone']}\n"
